# MagicTech — шаблон переменных окружения.
# Скопируйте в .env (файл в .gitignore) и заполните реальными значениями.
# Для боевого контура задавайте переменные окружения процесса, а не этот файл.

# ОБЯЗАТЕЛЬНО. Сгенерировать: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
# 1 — режим отладки (только локальная разработка), 0 — production
DJANGO_DEBUG=1
# Список разрешённых Host через запятую. Для production — только реальные домены.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# ОБЯЗАТЕЛЬНО. Секрет подписи веб-хуков ЮKassa. Сгенерировать:
# python -c "import secrets; print(secrets.token_hex(32))"
YOOKASSA_WEBHOOK_SECRET=

# ОБЯЗАТЕЛЬНО: доступ к PostgreSQL
DB_NAME=MagicTech
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# prefer | require | verify-full — для production используйте require или verify-full
DB_SSL_MODE=prefer

# Опционально
# REDIS_URL=redis://127.0.0.1:6379/1
# MAGTECH_BACKUP_DIR=./backups
# PG_BIN=C:/Program Files/PostgreSQL/18/bin
