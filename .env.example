# MagicTech — шаблон переменных окружения.
# Скопируйте в .env (файл в .gitignore) и заполните реальными значениями.
# Для боевого контура задавайте переменные окружения процесса, а не этот файл.

# ОБЯЗАТЕЛЬНО. Сгенерировать: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
# 1 — режим отладки (только локальная разработка), 0 — production
DJANGO_DEBUG=1
# Список разрешённых Host через запятую. Для production — только реальные домены.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# ОБЯЗАТЕЛЬНО. Секрет подписи веб-хуков ЮKassa. Сгенерировать:
# python -c "import secrets; print(secrets.token_hex(32))"
YOOKASSA_WEBHOOK_SECRET=

# ОБЯЗАТЕЛЬНО: доступ к PostgreSQL
DB_NAME=MagicTech
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# prefer | require | verify-full — для production используйте require или verify-full
DB_SSL_MODE=prefer

# Опционально
# REDIS_URL=redis://127.0.0.1:6379/1
# MAGTECH_BACKUP_DIR=./backups
# PG_BIN=C:/Program Files/PostgreSQL/18/bin

# HTTPS-включение (за приложением — nginx/cloud LB с SSL):
# MAGTECH_HTTPS=1

# Доверять X-Forwarded-For (только за своим прокси/ELB):
# MAGTECH_TRUST_XFF=1

# Лимит размера изображения (МБ) для товаров, отзывов, аватаров (по умолчанию 5):
# MAGTECH_MAX_IMAGE_MB=5

# Аудит ошибок API (по умолчанию 1 — включён):
# MAGTECH_API_ERROR_AUDIT=1

# Резерв под заказ «при получении» (минуты, по умолчанию 4320 = 3 дня):
# MAGTECH_COD_RESERVE_MINUTES=4320

# Лимит входов с одного IP для login_guard (по умолчанию 20):
# MAGTECH_LOGIN_MAX_IP=20

# Почта (SMTP):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.yandex.ru
# EMAIL_PORT=587
# EMAIL_HOST_USER=mailer@magictech.local
# EMAIL_HOST_PASSWORD=app_password
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=noreply@magictech.local
